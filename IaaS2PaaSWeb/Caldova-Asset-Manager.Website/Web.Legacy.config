<?xml version="1.0" encoding="utf-8"?>
<!-- Historical .NET Framework settings; excluded from the ASP.NET Core application. -->
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
  </configSections>
  <appSettings>
    <add key="ImagePath" value="/Images" />
    <add key="ShowRecommendations" value="false" />
    <add key="SiteDelayMilliseconds" value="0" />
    <!-- Public settings/references only; host CALDOVA_* overrides supported.
         No bootstrap credentials or inline provider/API secrets. See docs/KEY-VAULT-SECRETS.md. -->
    <add key="KeyVault.Uri" value="" />
    <add key="KeyVault.ManagedIdentityClientId" value="" />
    <add key="Authentication.Facebook.Enabled" value="false" />
    <add key="Authentication.Facebook.Key" value="" />
    <add key="Authentication.Facebook.SecretName" value="" />
    <add key="Authentication.Google.Enabled" value="false" />
    <add key="Authentication.Google.Key" value="" />
    <add key="Authentication.Google.SecretName" value="" />
    <add key="Authentication.Microsoft.Enabled" value="false" />
    <add key="Authentication.Microsoft.Key" value="" />
    <add key="Authentication.Microsoft.SecretName" value="" />
    <add key="Authentication.Twitter.Enabled" value="false" />
    <add key="Authentication.Twitter.Key" value="" />
    <add key="Authentication.Twitter.SecretName" value="" />
    <!-- Public scoring URL only (no query/credentials); CALDOVA_MACHINELEARNING_SCORINGENDPOINT overrides.
         Existing service contract, not a claim of availability. See docs/RECOMMENDATION-CONFIGURATION.md. -->
    <add key="MachineLearning.ScoringEndpoint" value="https://api.datamarket.azure.com/data.ashx/amla/mba/v1/Score" />
    <add key="MachineLearning.ModelName" value="sampletest" />
    <add key="MachineLearning.AccountKeySecretName" value="" />
    <add key="Keys:ApplicationInsights:InstrumentationKey" value="0839cc6f-b99b-44b1-9d74-4e408b7aee29" />
  </appSettings>
  <connectionStrings>
    <!-- LocalDB development only: retain the legacy transport behavior explicitly.
         External production connections must use Encrypt=True and a valid server certificate. -->
    <!-- Host supplies SQLCONNSTR_DefaultConnectionString or populates this named setting.
         No LocalDB/password fallback. See docs/SQL-MANAGED-INSTANCE.md. -->
    <add name="DefaultConnectionString" connectionString="" providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <customErrors mode="Off" />
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <httpModules>
    </httpModules>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Azure.Core" publicKeyToken="92742159e12e44c8" culture="neutral" />
