<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <MSDeployServiceURL>$(CaldovaPublishServiceUrl)</MSDeployServiceURL>
    <DeployIisAppPath>$(CaldovaPublishSiteName)</DeployIisAppPath>
    <UserName>$(CaldovaPublishUserName)</UserName>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <_SavePWD>false</_SavePWD>
  </PropertyGroup>
  <Target Name="ValidateCaldovaPublishConfiguration" BeforeTargets="MSDeployPublish">
    <Error Condition="'$(CaldovaPublishServiceUrl)' == ''" Text="Configure CaldovaPublishServiceUrl for the intended deployment target." />
    <Error Condition="'$(CaldovaPublishSiteName)' == ''" Text="Configure CaldovaPublishSiteName for the intended deployment target." />
  </Target>
</Project>
