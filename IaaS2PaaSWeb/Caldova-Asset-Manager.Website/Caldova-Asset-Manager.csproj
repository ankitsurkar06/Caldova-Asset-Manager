<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <RootNamespace>CaldovaAssetManager</RootNamespace>
    <AssemblyName>Caldova-Asset-Manager</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Generate Core IIS settings without applying historical System.Web transforms. -->
    <RunXdt>false</RunXdt>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Twitter" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="App_Start\**;Migrations\**;Bootstrapper.cs;Global.asax.cs;Startup.cs;Areas\Admin\AdminAreaRegistration.cs;Utils\CaldovaAssetManagerDbInitializer.cs;Utils\CaldovaAssetManagerTelemetryInitializer.cs;Utils\SignalRDependencyResolver.cs;Utils\SqlDatabaseConfiguration.cs;Security\ExternalSecretConfiguration.cs;Security\ConfigurationLoginProviderCredentials.cs;Security\ConfigurationLoginProviders.cs" />
    <Content Remove="**\*.config;packages.config;Models\project.json" />
    <None Remove="**\*.config;packages.config;Models\project.json" />
    <Content Include="Content\**;Images\**;Scripts\**;fonts\**;favicon.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
